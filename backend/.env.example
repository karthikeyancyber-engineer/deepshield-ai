# ====================================
# DeepShield AI - Environment Variables
# ====================================

# App Settings
APP_NAME=DeepShield AI
APP_VERSION=2.0.0
DEBUG=false

# Database (SQLite for simple deployments)
DATABASE_URL=sqlite+aiosqlite:///./deepshield.db

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# CORS (allow all origins in production)
CORS_ORIGINS=["*"]

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Frontend URL (leave empty for same-origin deployment)
FRONTEND_URL=

# Interview Link Expiry
INTERVIEW_LINK_EXPIRY_HOURS=24

# Email / OTP (optional - for password reset)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=60

# LiveKit (optional - for video interviews)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Trust Weights (must sum to 1.0)
TRUST_WEIGHT_FACE=0.25
TRUST_WEIGHT_VOICE=0.20
TRUST_WEIGHT_LIPSYNC=0.15
TRUST_WEIGHT_EYE_CONTACT=0.15
TRUST_WEIGHT_BEHAVIOR=0.15
TRUST_WEIGHT_ENVIRONMENT=0.10
